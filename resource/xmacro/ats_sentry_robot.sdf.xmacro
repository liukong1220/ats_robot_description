<?xml version="1.0"?>
<sdf version="1.7">

    <!--include defination-->
    <xmacro_include uri="model://rplidar_a2/model.sdf.xmacro" />
    <xmacro_include uri="model://mid360/model.sdf.xmacro" />
    <xmacro_include uri="model://industrial_camera/model.sdf.xmacro" />
    <!-- 四驱四转舵轮底盘：4 个 *_steer_joint + 4 个 *_wheel_joint。
         关节命名、转向轴、滚动轴与滚动半径与 MuJoCo 侧
         src/sim/ats_mujoco_sim/models/swerve_chassis.xml 保持一致。 -->
    <xmacro_include uri="model://ats_swerve_chassis/ats_swerve_chassis.def.xmacro" />
    <!--property defination-->
    <xmacro_define_value name="global_initial_color" value="none" />
    <xmacro_define_value name="global_armor_sticker_type" value="num3" />
    <!-- 坐标约定：
         x 向前，y 向左，z 向上；
         欧拉角顺序为 roll pitch yaw，单位 rad。 -->
    <!-- 实车近似外形：长 0.60m，宽 0.50m，总高 0.23m。 -->
    <xmacro_define_value name="chassis_length" value="0.60" />
    <xmacro_define_value name="chassis_width" value="0.50" />
    <xmacro_define_value name="robot_total_height" value="0.23" />
    <!-- 底盘高度约 10cm；云台紧贴底盘上表面，总云台高度约 13cm。 -->
    <xmacro_define_value name="chassis_height" value="0.10" />
    <!-- 大 yaw 轴中心相对于底盘参考点的 z 轴安装偏移，放在底盘上表面附近。 -->
    <xmacro_define_value name="gimbal_yaw_height" value="0.10" />
    <!-- pitch 轴相对 yaw 轴再上移约 3cm，使底盘 10cm + 云台 13cm 的高度关系闭合。 -->
    <xmacro_define_value name="gimbal_pitch_height" value="0.03" />
    <!-- Gazebo navigation profile: retain the 32-line Mid360 geometry while
         making its timing and ray density configurable by the launch owner.
         625 x 32 is the active-navigation default (200 k rays/s), matching
         the Mid360 point-rate model at 10 Hz. Diagnostic A/B runs may lower
         the update rate only when the bridge offset window and Point-LIO
         measurement interval use the same period. -->
    <xmacro_define_value name="nav_livox_update_rate_hz" value="10.0" />
    <xmacro_define_value name="nav_livox_horizontal_samples" value="625" />
    <!-- pitch 轴中心相对小 yaw 轴中心的安装偏置：
         x<0 表示在小 yaw 轴后方，y>0 表示在左侧，z>0 表示在上方。 -->
    <xmacro_define_value name="pitch_offset_x" value="-0.053" />
    <xmacro_define_value name="pitch_offset_y" value="0.0" />
    <xmacro_define_value name="pitch_offset_z" value="0.045" />
    <!-- 小 yaw 轴中心相对大 yaw 轴中心的安装偏置；
         非共轴结构必须按实车测量填写。 -->
    <xmacro_define_value name="small_yaw_offset_x" value="0.061" />
    <xmacro_define_value name="small_yaw_offset_y" value="0.00" />
    <xmacro_define_value name="small_yaw_offset_z" value="0.030" />

    <!--ats_sentry_robot model-->
    <model name="ats_sentry_robot">

        <!-- 整车模型原点相对世界原点的初始位姿。
             这里的 z=0.15 用于把模型整体抬到地面以上。 -->
        <pose>0 0 0.15 0 0 0</pose>
        <xmacro_block name="ats_swerve_chassis" sticker_type="${global_armor_sticker_type}" chassis_height="${chassis_height}" gimbal_yaw_height="${gimbal_yaw_height}" gimbal_pitch_height="${gimbal_pitch_height}" small_yaw_offset_x="${small_yaw_offset_x}" small_yaw_offset_y="${small_yaw_offset_y}" small_yaw_offset_z="${small_yaw_offset_z}" pitch_offset_x="${pitch_offset_x}" pitch_offset_y="${pitch_offset_y}" pitch_offset_z="${pitch_offset_z}"/>
        <!-- Livox 相对大 yaw 坐标系 `gimbal_yaw_odom` 的安装位姿：
             pose = x y z roll pitch yaw。 -->
        <!-- 横向射线数与更新频率由 launch owner 统一控制；它们不改变 32 个
             垂直 ring、传感器 frame 或时间戳。每帧扫描周期由 Gazebo bridge 与
             Point-LIO 从同一 nav_livox_update_rate_hz 推导，禁止单独修改。 -->
        <xmacro_block name="livox" prefix="front_" parent="gimbal_yaw_odom" pose="-0.2 -0.0 0.0 0.0 0 -${61*pi/180}" update_rate="${nav_livox_update_rate_hz}" samples="${nav_livox_horizontal_samples}"/>
        <!-- 工业相机相对 pitch 坐标系 `gimbal_pitch` 的安装位姿：
             pose = x y z roll pitch yaw。 -->
        <xmacro_block name="industrial_camera" prefix="front_" parent="gimbal_pitch" pose="0.1 0 0.045 0 0 0" update_rate="30" horizontal_fov="1" width="1920" height="1080"/>

        <!--plugins-->
        <!-- https://github.com/gazebosim/gz-sim/blob/ign-gazebo6/src/systems -->

        <!--plugin for joint state sensor-->
        <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
        </plugin>

        <!-- LightBarController 在此机型上被刻意省略。该插件通过
             RequestRemoveEntity + 下一帧 CreateEntities 重建同名 visual 来换色；
             本机型带 gpu_lidar 与相机，服务端即使 headless 也会运行 Sensors
             渲染线程，删除尚未被渲染侧消化时重建就已到达，SceneManager 报
             "Another item already exists with name: <model>::armor_0::light_bar_visual"
             并在 CreateVisual 处解引用空指针，整个 ign gazebo 段错误退出。
             灯条颜色只服务于视觉识别，与导航链无关，故不在此启用；
             需要灯条的机型（simulation_robot / ats_infantry_robot 等）保持原样。 -->

        <!--plugin for chassis control-->
        <!-- 四驱四转舵轮执行器。输入为车体系 [vx, vy, wz]，插件按舵轮逆运动学
             解算每个模块的 (舵角, 轮速) 并下发到真实关节；零速度命令执行安全停机，
             命令超时同样按零速度处理。 -->
        <plugin filename="AtsSwerveDrive4WS" name="ignition::gazebo::systems::AtsSwerveDrive4WS">
            <chassis_link>chassis</chassis_link>
            <wheel_radius>0.0425</wheel_radius>
            <max_wheel_speed>39.26991</max_wheel_speed>
            <max_steer_rate>12.0</max_steer_rate>
            <steer_p_gain>12.0</steer_p_gain>
            <command_timeout>0.5</command_timeout>
            <module>
                <steer_joint>front_left_steer_joint</steer_joint>
                <wheel_joint>front_left_wheel_joint</wheel_joint>
                <x>0.270</x>
                <y>0.270</y>
            </module>
            <module>
                <steer_joint>front_right_steer_joint</steer_joint>
                <wheel_joint>front_right_wheel_joint</wheel_joint>
                <x>0.270</x>
                <y>-0.270</y>
            </module>
            <module>
                <steer_joint>rear_left_steer_joint</steer_joint>
                <wheel_joint>rear_left_wheel_joint</wheel_joint>
                <x>-0.270</x>
                <y>0.270</y>
            </module>
            <module>
                <steer_joint>rear_right_steer_joint</steer_joint>
                <wheel_joint>rear_right_wheel_joint</wheel_joint>
                <x>-0.270</x>
                <y>-0.270</y>
            </module>
        </plugin>

        <!--plugin for gimbal control-->
        <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
            <joint_name>gimbal_yaw_joint</joint_name>
            <use_force_commands>false</use_force_commands>
            <p_gain>0.2</p_gain>
            <i_gain>0.01</i_gain>
        </plugin>

        <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
            <joint_name>gimbal_pitch_joint</joint_name>
            <use_force_commands>false</use_force_commands>
            <p_gain>1</p_gain>
            <i_gain>0.01</i_gain>
        </plugin>

        <!--plugin for shooter-->
        <plugin filename="ProjectileShooter" name="ignition::gazebo::systems::ProjectileShooter">
            <shooter_link>speed_monitor</shooter_link>
            <shooter_offset>0.15 0 0 0 0 0</shooter_offset>
            <shooter_name>small_shooter</shooter_name>
            <projectile_velocity>20</projectile_velocity>
            <projectile_uri>model://rm_projectile_17mm</projectile_uri>
        </plugin>
    </model>
</sdf>
